<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SecondColor">#F3F3F3</Color>
    <SolidColorBrush x:Key="SecondColorBrush" Color="{StaticResource SecondColor}"/>
    <Color x:Key="MainColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="MainColorBrush" Color="{StaticResource MainColor}"/>
    <Color x:Key="TextColor">#233E76</Color>
    <SolidColorBrush x:Key="TextColorBrush" Color="{StaticResource TextColor}"/>
    <Color x:Key="MouseOnColor">#0198AF</Color>
    <SolidColorBrush x:Key="MouseOnColorBrush" Color="{StaticResource MouseOnColor}"/>
    <SolidColorBrush x:Key="BorderColorBrush" Color="{StaticResource TextColor}"/>
    <Color x:Key="SecondTextColor">#233E76</Color>
    <SolidColorBrush x:Key="SecondTextColorBrush" Color="{StaticResource SecondTextColor}"/>
</ResourceDictionary>