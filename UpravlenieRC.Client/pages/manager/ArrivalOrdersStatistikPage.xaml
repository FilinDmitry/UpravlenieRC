<Page x:Class="UpravlenieRC.Client.pages.manager.ArrivalOrdersStatistikPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UpravlenieRC.Client.pages.manager"
      xmlns:local2="clr-namespace:UpravlenieRC.Client.conventers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ArrivalOrdersStatistikPage">
    <Page.Resources>
        <local2:CountToHeightConverter x:Key="CountToHeightConverter" ></local2:CountToHeightConverter>
    </Page.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Количество заказов за последние 10 дней"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- График -->
        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Background="#F5F5F5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl  ItemsSource="{Binding OrdersByDate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,0">
                                <TextBlock Text="{Binding Count}"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="0,-24,0,0"
           FontWeight="Bold"
           Foreground="Black"
           FontSize="12"/>
                                <!-- Столбик -->
                                <Rectangle Fill="#4A90E2"
                                           Width="24"
                                           VerticalAlignment="Bottom"
                                           Height="{Binding Count, Converter={StaticResource CountToHeightConverter}, ConverterParameter=50}">
                                    <!-- Подсказка при наведении -->
                                    
                                </Rectangle>

                                <!-- Дата (подпись под столбиком) -->
                                <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Margin="0,4"
                                           FontSize="11"
                                           Foreground="#555"/>

                                <!-- Число (над столбиком) -->
                                
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
