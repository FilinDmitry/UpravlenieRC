<Page x:Class="UpravlenieRC.Client.pages.manager.GoodsManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UpravlenieRC.Client.pages.manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GoodsManagerPage">
    <Page.Resources>
        <Style  BasedOn="{StaticResource DefaultTB}" TargetType="TextBlock"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
            <Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBox TextChanged="Search_TextChanged" MinWidth="350" x:Name="Search" Grid.Column="1"></TextBox>
                    <TextBlock Margin="25, 0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="20" Foreground="{StaticResource TextColorBrush}" Text="Введите поисковый запрос" Grid.Column="1">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>

            </Border>
            <Grid>
                <ComboBox SelectionChanged="CB_SelectionChanged" x:Name="CB_Categories" Style="{StaticResource Combo}" FontSize="14">

                </ComboBox>
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="16" Foreground="{StaticResource TextColorBrush}" Text="Категория" Grid.Column="1">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CB_Categories}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid>
                <ComboBox SelectionChanged="CB_SelectionChanged" Width="140" x:Name="Sort" Style="{StaticResource Combo}" FontSize="14">
                    <ComboBoxItem>
                        <TextBlock Text="По убыванию"></TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <TextBlock Text="По возрастанию"></TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <TextBlock Text="По стоимости"></TextBlock>
                    </ComboBoxItem>
                </ComboBox>
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="16" Foreground="{StaticResource TextColorBrush}" Text="Сортировка" Grid.Column="1">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Sort}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid>
                <Button Content="Сохранить" Height="50" Margin="0" Click="Button_Click"></Button>
            </Grid>
        </StackPanel>
        <ListBox x:Name="LB_catalog" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        
                        
                        <Border BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1.5" CornerRadius="5" Padding="3">
                            <StackPanel>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanEdit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Button Click="Change_Click" x:Name="Change" Content="с" FontSize="10" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0" Height="20" Width="20">
                                        
                                    </Button>


                                    <Button Click="Delete_Click" x:Name="Delete" Content="d" Padding="0" FontSize="10" VerticalAlignment="Top"
                                        HorizontalAlignment="Left" Margin="0" Height="20" Width="20">
                                        
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding Name}"></TextBlock>
                                <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}"></TextBlock>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox HorizontalAlignment="Left"  Width="30" Height="30">
                                        <Button x:Name="Minus" Content="-" Click="Minus_Click" Margin="0" Height="50" Width="50"/>
                                    </Viewbox>
                                    <TextBlock Margin="10, 0, 10, 0" HorizontalAlignment="Center" Grid.Column="1" MouseLeftButtonDown="Change_MouseLeftButtonDown">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Amount"/>
                                                <Binding Path="Units"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Viewbox Grid.Column="2" HorizontalAlignment="Right" Width="30" Height="30">
                                        <Button x:Name="Plus" Click="Plus_Click" Content="+" Margin="0" Height="50" Width="50"/>
                                    </Viewbox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center">
            <Button  Margin="0" Content="Создать новый товар" Click="Create_Click"></Button>
            <!--<Button  Margin="0"  Content="Восстановить товар" Click="Restore_Click"></Button>-->
        </StackPanel>
    </Grid>
</Page>

