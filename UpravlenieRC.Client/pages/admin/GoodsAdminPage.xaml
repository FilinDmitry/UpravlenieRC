<Page x:Class="UpravlenieRC.Client.pages.admin.GoodsAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UpravlenieRC.Client.pages.admin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GoodsAdminPage">
    <Page.Resources>
        <Style BasedOn="{StaticResource DefaultTB}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0, 10"></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="10"></Setter>
            <Setter Property="Width" Value="400"></Setter>
            <Setter Property="FontSize" Value="16"></Setter>
            <Setter Property="Height" Value="30"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="Background" Value="{DynamicResource SecondColorBrush}"></Setter>
            <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"></Setter>
            <Setter Property="Padding" Value="5"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="TextAlignment" Value="Left"></Setter>
        </Style>
        <Style TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="Orientation" Value="Horizontal"></Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="AUTO"></RowDefinition>
            <RowDefinition Height="AUTO"></RowDefinition>
            <RowDefinition Height="AUTO"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Name"></TextBlock>
            <TextBox x:Name="TB_TovarName"></TextBox>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Category"></TextBlock>
            <ComboBox x:Name="CB_TovarCategory" Width="300" Height="40" Style="{StaticResource Combo}" DisplayMemberPath="name"
                      SelectedValuePath="Id" SelectedValue="{Binding _good.Units, Mode=OneWay}"></ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock  Text="Units"></TextBlock>
            <ComboBox  x:Name="CB_TovarUnits" Width="150" Height="40" Style="{StaticResource Combo}" DisplayMemberPath="name"
                       SelectedValuePath="Id" SelectedValue="{Binding _good.Units, Mode=OneWay}"></ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock  Text="Manufacturer"></TextBlock>
            <ComboBox x:Name="CB_TovarManufact" Width="400" Height="40" Style="{StaticResource Combo}" DisplayMemberPath="name"
                      SelectedValuePath="Id" SelectedValue="{Binding _good.Units, Mode=OneWay}"></ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock  Text="MinTemp"></TextBlock>
            <TextBox x:Name="TB_MinTemp" Width="60"></TextBox>
            <TextBlock  Text="MaxTemp"></TextBlock>
            <TextBox x:Name="TB_MaxTemp" Width="60"></TextBox>
        </StackPanel>
        <StackPanel Grid.Row="5">
            <TextBlock Text="Volume"></TextBlock>
            <TextBox x:Name="TB_Volume" Width="60"></TextBox>
            <TextBlock Text="Weight"></TextBlock>
            <TextBox x:Name="TB_Weight"  Width="60"></TextBox>
        </StackPanel>
        <StackPanel Grid.Row="6">
            <TextBlock  Text="Price"></TextBlock>
            <TextBox x:Name="TB_Price" Width="250"></TextBox>
        </StackPanel>
        <Button Margin="0" Content="Изменить/создать" Click="Change_Click" Grid.Row="7" x:Name="Change"></Button>
    </Grid>
</Page>
