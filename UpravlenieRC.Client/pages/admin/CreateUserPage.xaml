<Page x:Class="UpravlenieRC.Client.pages.admin.CreateUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UpravlenieRC.Client.pages.admin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreateUserPage">
    <Page.Resources>
        <Style  BasedOn="{StaticResource DefaultTB}" TargetType="TextBlock"/>
    </Page.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="AUTO"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="AUTO"></RowDefinition>
            <RowDefinition Height="AUTO"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button Content="Назад" Grid.Column="1" Height="30" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0" FontSize="10" ></Button>
        <TextBlock  Text="Логин" Grid.Row="1"  HorizontalAlignment="Right" Margin="0, 0, 0, 0"></TextBlock>
        <TextBox x:Name="TB_Login" Width="400" Margin="20, 0, 0, 0" Height="30" FontSize="14" Grid.Row="1" Grid.Column="1"  HorizontalAlignment="Left"></TextBox>
        <TextBlock Text="Пароль" Grid.Row="2"  Margin="0, 0, 0, 0" HorizontalAlignment="Right"></TextBlock>
        <PasswordBox x:Name="TB_password" Height="30" FontSize="14" Width="400" Grid.Row="2" Grid.Column="1" Margin="20, 0, 0, 0" HorizontalAlignment="Left"></PasswordBox>
        <TextBlock Text="Повторите пароль" Grid.Row="3"  Margin="0, 0, 0, 0" HorizontalAlignment="Right"></TextBlock>
        <PasswordBox x:Name="TB_passwordRepeat" Height="30" FontSize="14" Width="400" Grid.Row="3" Grid.Column="1" Margin="20, 0, 0, 0" HorizontalAlignment="Left"></PasswordBox>
        <TextBlock Text="Email" Grid.Row="4"  HorizontalAlignment="Right" Margin="0, 0, 0, 0"></TextBlock>
        <TextBox x:Name="TB_email"  Width="400" Grid.Row="4" Height="30" FontSize="14" Grid.Column="1" Margin="20, 0, 0, 0" HorizontalAlignment="Left"></TextBox>
        <TextBlock Text="Телефон" Grid.Row="5"  HorizontalAlignment="Right" Margin="0, 0, 0, 0"></TextBlock>
        <TextBox x:Name="TB_Phone"  Width="400" Grid.Row="5" Height="30" FontSize="14" Grid.Column="1" Margin="20, 0, 0, 0" HorizontalAlignment="Left"></TextBox>
        <TextBlock Text="Роль" Grid.Row="6"  HorizontalAlignment="Right" Margin="0, 0, 0, 0"></TextBlock>
        <ComboBox Style="{StaticResource Combo}" Height="35" x:Name="CB_Role" Grid.Row="6" HorizontalAlignment="Left" Margin="20, 5, 0, 0" Grid.Column="1" Width="400"></ComboBox>
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            
            <Button Content="Создать" Height="50" Width="200" Margin="10" Click="Create_Click"></Button>
            

        </StackPanel>

    </Grid>
</Page>
