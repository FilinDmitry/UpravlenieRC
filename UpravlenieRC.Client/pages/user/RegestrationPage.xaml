<Page x:Class="UpravlenieRC.Client.pages.RegestrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UpravlenieRC.Client.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegestrationPage">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="10"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="AUTO"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Логин" Grid.Row="1"  HorizontalAlignment="Right" Margin="0, 0, 0, 0"></TextBlock>
        <TextBox x:Name="TB_Login" Width="400" Height="30" FontSize="16" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"></TextBox>
        <TextBlock Text="Пароль" Grid.Row="2"  Margin="0, 0, 0, 0" HorizontalAlignment="Right"></TextBlock>
        <PasswordBox x:Name="TB_password" Height="30" FontSize="16" Width="400" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"></PasswordBox>
        <TextBlock Text="Повторите пароль" Grid.Row="3"  Margin="0, 0, 0, 0" HorizontalAlignment="Right"></TextBlock>
        <PasswordBox x:Name="TB_passwordRepeat" Height="30" FontSize="16" Width="400" Grid.Row="3" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"></PasswordBox>
        <TextBlock Text="ИНН организации" Grid.Row="4"  HorizontalAlignment="Right" Margin="0, 0, 0, 0"></TextBlock>
        <TextBox x:Name="TB_INN" Width="400" Grid.Row="4" Height="30" FontSize="16" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"></TextBox>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <StackPanel Height="100" x:Name="SP_Captcha">
                <TextBlock HorizontalAlignment="Center" Text="Введите текст captcha"></TextBlock>
                <StackPanel Orientation="Horizontal">

                    <TextBlock x:Name="Captcha_displayer" Width="200"></TextBlock>
                    <TextBox FontSize="14" Height="Auto" x:Name="TB_Captcha" Width="300"></TextBox>
                </StackPanel>
            </StackPanel>
            <Button Content="Войти" Width="200" Margin="10" Click="Button_Click"></Button>
            <TextBlock MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" TextAlignment="Center" Text="Уже есть аккаунт? Войти" FontStyle="Italic" TextDecorations="Baseline" Margin="0"></TextBlock>

        </StackPanel>

    </Grid>
</Page>
